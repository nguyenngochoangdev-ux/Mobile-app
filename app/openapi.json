{"openapi":"3.1.0","info":{"title":"DRL API — Sổ tay hoạt động sinh viên","description":"Điểm danh nhiều lớp kiểm tra, chấm điểm rèn luyện, neo dữ liệu lên Polygon Amoy.","version":"v1"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Credential","description":"Cấp và tra cứu credential có chữ ký của tổ chức"},{"name":"Events","description":"Sự kiện và hoạt động"},{"name":"Organizations","description":"Tổ chức cấp phát: trường, khoa, đoàn, CLB…"},{"name":"Scoring","description":"Chấm điểm rèn luyện theo bộ quy tắc có version"},{"name":"Registrations","description":"Đăng ký tham gia sự kiện"},{"name":"Auth","description":"Đăng nhập, làm mới token"},{"name":"Students","description":"Hồ sơ sinh viên"},{"name":"Devices","description":"Đăng ký và duyệt thiết bị của sinh viên"},{"name":"Attendance","description":"Điểm danh nhiều lớp kiểm tra"},{"name":"Users","description":"Quản lý tài khoản"}],"paths":{"/api/students/{id}":{"get":{"tags":["Students"],"operationId":"get","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/StudentResponse"}}}}}},"put":{"tags":["Students"],"operationId":"update","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StudentRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/StudentResponse"}}}}}}},"/api/organizations/{id}":{"get":{"tags":["Organizations"],"operationId":"get_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrgResponse"}}}}}},"put":{"tags":["Organizations"],"operationId":"update_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrgRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrgResponse"}}}}}}},"/api/events/{id}":{"get":{"tags":["Events"],"operationId":"get_2","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventResponse"}}}}}},"put":{"tags":["Events"],"operationId":"update_2","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EventRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventResponse"}}}}}}},"/api/users/me/change-password":{"post":{"tags":["Users"],"summary":"Tự đổi mật khẩu","operationId":"changePassword","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangePasswordRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}},"/api/students":{"get":{"tags":["Students"],"summary":"Tìm kiếm sinh viên theo tên/MSSV, lọc theo lớp và khoa","operationId":"list","parameters":[{"name":"q","in":"query","required":false,"schema":{"type":"string"}},{"name":"classCode","in":"query","required":false,"schema":{"type":"string"}},{"name":"facultyId","in":"query","required":false,"schema":{"type":"integer","format":"int64"}},{"name":"pageable","in":"query","required":true,"schema":{"$ref":"#/components/schemas/Pageable"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageStudentResponse"}}}}}},"post":{"tags":["Students"],"operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StudentRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/StudentResponse"}}}}}}},"/api/scoring/run":{"post":{"tags":["Scoring"],"summary":"Chấm điểm toàn khóa cho một học kỳ","description":"Nạp bộ quy tắc từ `classpath:rulesets/<version>.json`, KIỂM nó, rồi mới chấm — có\nlỗi thì không chấm ai cả.\n\nChấm lại tạo LƯỢT MỚI, không sửa lượt cũ: điểm đã chấm là phát biểu đã (sắp) được\nneo, sửa nó làm mọi Merkle proof fail vĩnh viễn.\n\nMỗi bản ghi mang `evidence_hash` — cam kết vào đúng tập bản ghi điểm danh đã dùng.\nCùng với `ruleset_hash`, nó làm điểm số tái tính lại được bởi người ngoài mà không\ncần máy chủ của trường.\n","operationId":"runScoring","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/KetQuaLuot"}}}}}}},"/api/organizations":{"get":{"tags":["Organizations"],"summary":"Danh sách tổ chức, lọc theo loại","operationId":"list_1","parameters":[{"name":"type","in":"query","required":false,"schema":{"type":"string","enum":["TRUONG","KHOA","DOAN","HOI_SV","CLB","TRUNG_TAM","DOANH_NGHIEP"]}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/OrgResponse"}}}}}}},"post":{"tags":["Organizations"],"summary":"Tạo tổ chức mới","operationId":"create_1","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrgRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrgResponse"}}}}}}},"/api/events":{"get":{"tags":["Events"],"summary":"Danh sách sự kiện, phân trang","operationId":"list_2","parameters":[{"name":"status","in":"query","required":false,"schema":{"type":"string","enum":["DRAFT","OPEN","RUNNING","CLOSED"]}},{"name":"orgId","in":"query","required":false,"schema":{"type":"integer","format":"int64"}},{"name":"pageable","in":"query","required":true,"schema":{"$ref":"#/components/schemas/Pageable"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageEventResponse"}}}}}},"post":{"tags":["Events"],"summary":"Tạo sự kiện. Secret HMAC sinh phía server, không nhận từ client.","operationId":"create_2","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EventRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventResponse"}}}}}}},"/api/events/{eventId}/register":{"post":{"tags":["Registrations"],"summary":"Sinh viên tự đăng ký tham gia sự kiện","operationId":"registerForEvent","parameters":[{"name":"eventId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RegistrationResponse"}}}}}},"delete":{"tags":["Registrations"],"summary":"Sinh viên huỷ đăng ký","operationId":"cancel","parameters":[{"name":"eventId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RegistrationResponse"}}}}}}},"/api/devices/register":{"post":{"tags":["Devices"],"summary":"Sinh viên đăng ký thiết bị của mình","operationId":"registerDevice","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DeviceResponse"}}}}}}},"/api/credentials":{"post":{"tags":["Credential"],"summary":"Cấp credential cho một sinh viên","description":"Chụp ảnh MSSV/họ tên/địa chỉ ví, cấp status_list_index ngẫu nhiên, dựng payload\nchuẩn tắc, tính leaf hash và ký bằng khóa của tổ chức. Credential được neo ở lần\nchạy job neo tiếp theo.\n\nKHÔNG có endpoint sửa credential — đó là chủ ý. Credential là phát biểu đã ký;\nsửa nó làm mọi Merkle proof fail vĩnh viễn. Muốn đổi nội dung thì thu hồi rồi cấp\nlại, đúng mô hình W3C Verifiable Credentials.\n","operationId":"issueCredential","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/IssueRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CredentialResponse"}}}}}}},"/api/credentials/{id}/revoke":{"post":{"tags":["Credential"],"summary":"Thu hồi credential (lật bit trên StatusList)","description":"Gửi giao dịch `setRevoked` lên chuỗi TRƯỚC, ghi CSDL SAU — ngược thứ tự với job neo,\nvà đó là chủ ý: nguồn sự thật về thu hồi là bit trên chuỗi, vì đó là thứ duy nhất\nverifier đọc. Ghi CSDL trước rồi giao dịch hỏng sẽ làm trang quản trị báo \"đã thu\nhồi\" trong khi nhà tuyển dụng chạy verifier vẫn thấy credential còn hiệu lực.\n\nĐặt `revoked = false` để BỎ thu hồi. Thao tác này đảo ngược được (khác `anchor`),\nnhưng lịch sử thì không: mỗi lần lật để lại một sự kiện `StatusChanged` vĩnh viễn.\n\nCần `drl.anchor.enabled=true`. Cố ý KHÔNG có chế độ thu hồi cục bộ.\n","operationId":"revokeCredential","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RevokeRequest"}}}},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Result"}}}}}}},"/api/auth/refresh":{"post":{"tags":["Auth"],"summary":"Đổi refresh token lấy access token mới","operationId":"refresh","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TokenResponse"}}}}}}},"/api/auth/login":{"post":{"tags":["Auth"],"summary":"Đăng nhập bằng username + password","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TokenResponse"}}}}}}},"/api/attendance/sync":{"post":{"tags":["Attendance"],"summary":"Đồng bộ các lần quét đã lưu offline","operationId":"sync","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SyncRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SyncResult"}}}}}}},"/api/attendance/scan-student":{"post":{"tags":["Attendance"],"summary":"Cán bộ quét QR của sinh viên — luồng đảo chiều (method QR_SHOW)","operationId":"scanStudent","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StaffScanRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/StaffScanResponse"}}}}}}},"/api/attendance/manual":{"post":{"tags":["Attendance"],"summary":"Cán bộ điểm danh tay — verified = false (vấn đề oracle)","operationId":"manual","parameters":[{"name":"eventId","in":"query","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"studentId","in":"query","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AttendanceResponse"}}}}}}},"/api/attendance/checkout":{"post":{"tags":["Attendance"],"summary":"Check-out khỏi sự kiện","operationId":"checkout","parameters":[{"name":"eventId","in":"query","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AttendanceResponse"}}}}}}},"/api/attendance/checkin":{"post":{"tags":["Attendance"],"summary":"Sinh viên quét QR để check-in — qua năm bước kiểm tra","operationId":"checkin","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CheckinRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AttendanceResponse"}}}}}}},"/api/users/{id}/enabled":{"patch":{"tags":["Users"],"summary":"Khoá hoặc mở khoá tài khoản","operationId":"setEnabled","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"enabled","in":"query","required":true,"schema":{"type":"boolean"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}},"/api/events/{id}/status":{"patch":{"tags":["Events"],"summary":"Đổi trạng thái sự kiện","operationId":"changeStatus","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"status","in":"query","required":true,"schema":{"type":"string","enum":["DRAFT","OPEN","RUNNING","CLOSED"]}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EventResponse"}}}}}}},"/api/devices/{id}/revoke":{"patch":{"tags":["Devices"],"summary":"Cán bộ thu hồi thiết bị","operationId":"revoke","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DeviceResponse"}}}}}}},"/api/devices/{id}/approve":{"patch":{"tags":["Devices"],"summary":"Cán bộ duyệt thiết bị","operationId":"approve","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DeviceResponse"}}}}}}},"/api/users":{"get":{"tags":["Users"],"summary":"Danh sách tài khoản","operationId":"list_3","parameters":[{"name":"pageable","in":"query","required":true,"schema":{"$ref":"#/components/schemas/Pageable"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageUserResponse"}}}}}}},"/api/students/mssv/{mssv}":{"get":{"tags":["Students"],"summary":"Tra cứu theo MSSV — dùng khi cán bộ điểm danh thủ công","operationId":"getByMssv","parameters":[{"name":"mssv","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/StudentResponse"}}}}}}},"/api/scoring/student/{studentId}":{"get":{"tags":["Scoring"],"summary":"Điểm của một sinh viên","operationId":"scoresOfStudent","parameters":[{"name":"studentId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ScoreResponse"}}}}}}}},"/api/scoring/rulesets/{semester}":{"get":{"tags":["Scoring"],"summary":"Bộ quy tắc đang áp dụng cho một học kỳ","description":"Trả về NGUYÊN VĂN nội dung tệp. Đây là tài liệu công khai — sinh viên phải đọc được\nđể tự tính lại điểm của mình.\n\n`diemTuDuLieu` / `diemMacDinh` nói bao nhiêu phần của thang 100 là kết quả đo đạc và\nbao nhiêu là giả định. Hai con số này tính từ chính bộ quy tắc, nên chúng không lệch\nđược khỏi tệp đang dùng.\n","operationId":"getRuleset","parameters":[{"name":"semester","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/RulesetResponse"}}}}}}},"/api/scoring/me":{"get":{"tags":["Scoring"],"summary":"Điểm rèn luyện của chính mình, mới trước cũ sau","operationId":"myScores","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ScoreResponse"}}}}}}}},"/api/registrations/me":{"get":{"tags":["Registrations"],"summary":"Các sự kiện tôi đã đăng ký","operationId":"myRegistrations","parameters":[{"name":"pageable","in":"query","required":true,"schema":{"$ref":"#/components/schemas/Pageable"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageRegistrationResponse"}}}}}}},"/api/events/{eventId}/registrations":{"get":{"tags":["Registrations"],"summary":"Danh sách đăng ký của một sự kiện","operationId":"listByEvent","parameters":[{"name":"eventId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"pageable","in":"query","required":true,"schema":{"$ref":"#/components/schemas/Pageable"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageRegistrationResponse"}}}}}}},"/api/devices/student/{studentId}":{"get":{"tags":["Devices"],"summary":"Thiết bị của một sinh viên","operationId":"byStudent","parameters":[{"name":"studentId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/DeviceResponse"}}}}}}}},"/api/devices/pending":{"get":{"tags":["Devices"],"summary":"Hàng đợi thiết bị chờ duyệt","operationId":"pending","parameters":[{"name":"pageable","in":"query","required":true,"schema":{"$ref":"#/components/schemas/Pageable"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageDeviceResponse"}}}}}}},"/api/devices/me":{"get":{"tags":["Devices"],"summary":"Thiết bị của tôi","operationId":"myDevices","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/DeviceResponse"}}}}}}}},"/api/credentials/{id}":{"get":{"tags":["Credential"],"summary":"Chi tiết một credential","operationId":"getCredential","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CredentialResponse"}}}}}}},"/api/credentials/{id}/bundle":{"get":{"tags":["Credential"],"summary":"Xuất bundle xác minh độc lập","description":"Tệp JSON tự chứa: payload đã ký, chữ ký, Merkle proof, batchId và địa chỉ contract.\nXác minh bằng `cd verifier && node scripts/verify-bundle.mjs <tệp>` — script đó chỉ\ndùng ethers + merkletreejs và KHÔNG gọi backend một dòng nào.\n\nĐịa chỉ contract trong mục `chain` là THÔNG TIN, không phải cấu hình: verifier giữ\ndanh sách địa chỉ tin cậy của riêng nó và từ chối bundle khai địa chỉ khác. Tin\nđịa chỉ trong bundle là cách phá hệ thống rẻ nhất — kẻ tấn công chỉ cần deploy một\ncontract trả về root do mình chọn.\n\nChỉ xuất được sau khi credential đã neo và lô đã lên chuỗi.\n","operationId":"credentialBundle","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Bundle"}}}}}}},"/api/credentials/student/{studentId}":{"get":{"tags":["Credential"],"summary":"Credential của một sinh viên","operationId":"credentialsOfStudent","parameters":[{"name":"studentId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CredentialResponse"}}}}}}}},"/api/credentials/me":{"get":{"tags":["Credential"],"summary":"Credential của chính mình","operationId":"myCredentials","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CredentialResponse"}}}}}}}},"/api/auth/me":{"get":{"tags":["Auth"],"summary":"Thông tin tài khoản đang đăng nhập","operationId":"me","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MeResponse"}}}}}