# Copy sang .env rồi điền. KHÔNG commit .env.

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=drl
MYSQL_USER=drl
MYSQL_PASSWORD=drlpw
MYSQL_PORT=3306

# ===== JWT =====
# Sinh bằng: openssl rand -base64 64
JWT_SECRET=doi-gia-tri-nay-truoc-khi-chay
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

# ===== Blockchain — Polygon Amoy (chainId 80002) =====
# KHÔNG dùng rpc-amoy.polygon.technology: Polygon đã ngừng RPC công cộng 17/07/2026.
# Lấy endpoint miễn phí từ Alchemy / Infura / Chainstack / QuickNode.
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/DAT_API_KEY_VAO_DAY
AMOY_RPC_URL_FALLBACK=
CHAIN_ID=80002

# Ví triển khai — lấy test POL từ faucet Polygon.
# Ví này CHỈ dùng cho testnet. Không bao giờ dùng ví có tiền thật.
# Nó cũng là DEFAULT_ADMIN_ROLE của cả ba contract.
DEPLOYER_PRIVATE_KEY=

# Khóa ký giao dịch neo hằng đêm. Phải có ANCHOR_ROLE trên AnchorRegistry.
# Tách khỏi khóa triển khai là có chủ ý: contract cấp ANCHOR_ROLE riêng nên khóa admin
# cất được offline sau khi cấp quyền. Khóa này lộ thì kẻ tấn công neo được root rác,
# nhưng KHÔNG sửa được lô đã neo và không cấp/thu quyền được cho ai.
# Giai đoạn đầu có thể dùng chung khóa triển khai; tách trước khi viết báo cáo.
ANCHOR_PRIVATE_KEY=

# Bật job neo. Mặc định TẮT — phần lớn thời gian phát triển không cần chạm chuỗi,
# và bật sẵn nghĩa là app không khởi động được khi mất mạng hoặc .env chưa điền khóa.
ANCHOR_ENABLED=false

# Địa chỉ contract sau khi deploy (điền ở tuần 3)
ISSUER_REGISTRY_ADDRESS=
ANCHOR_REGISTRY_ADDRESS=
STATUS_LIST_ADDRESS=

# ===== Khóa ký credential =====
# Khóa của TỔ CHỨC cấp phát (không phải khóa sinh viên — xem docs/scope.md,
# HD wallet per-student đã bị cắt).
# Backup 2 bản mã hóa NGOÀI repo. Mất khóa này = không ký được credential mới.
ISSUER_PRIVATE_KEY=

# ===== Etherscan API V2 (verify contract) =====
# KHÔNG còn key riêng cho PolygonScan. Từ 15/08/2025 API V1 đã tắt; Etherscan hợp nhất
# toàn bộ họ explorer thành API V2 — một key dùng cho 60+ chain, phân biệt bằng `chainid`.
# Lấy tại etherscan.io → API Dashboard (miễn phí). Amoy = chainid 80002.
# Kiểm tra key:
#   curl "https://api.etherscan.io/v2/api?chainid=80002&module=stats&action=ethsupply&apikey=KEY"
ETHERSCAN_API_KEY=

# ===== Lưu file minh chứng =====
# MinIO đã bị cắt khỏi phạm vi — dùng thư mục cục bộ.
UPLOAD_DIR=./uploads
