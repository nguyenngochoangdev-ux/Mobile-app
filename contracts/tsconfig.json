{
  "compilerOptions": {
    "target": "ES2023",
    "module": "node20",
    "moduleResolution": "node16",
    "lib": ["ES2023"],
    "types": ["node", "mocha"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["hardhat.config.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
